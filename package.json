{
  "name": "mcp-aggregator",
  "version": "0.1.0",
  "description": "MCP (Model Context Protocol) aggregator proxy",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dodwmd/mcp-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/dodwmd/mcp-proxy/issues"
  },
  "homepage": "https://github.com/dodwmd/mcp-proxy#readme",
  "bin": {
    "mcp-aggregator": "dist/bin/mcp-aggregator.js",
    "mcp-aggregator-stdio": "dist/bin/mcp-aggregator-stdio.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "tsx watch bin/mcp-aggregator.ts -- start",
    "build": "pnpm build:server && pnpm build:cli",
    "build:server": "tsc --project tsconfig.build.json",
    "build:cli": "esbuild bin/mcp-aggregator.ts --bundle --platform=node --format=esm --outfile=dist/bin/mcp-aggregator.js --external:@modelcontextprotocol/sdk --external:drizzle-orm --external:better-sqlite3 --external:commander --external:yaml --external:chokidar",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm build:server && drizzle-kit generate",
    "db:migrate": "pnpm build:server && tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.38.3",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.3",
    "esbuild": "^0.24.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxy",
    "aggregator",
    "agent",
    "tools"
  ],
  "author": "",
  "license": "MIT"
}
